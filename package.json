{
  "name": "hs-monolith",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "nodemon backend/server.js",
    "build": "npx prisma generate --schema=backend/prisma/schema.prisma && npx vite build",
    "start": "node backend/server.js",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:db-push": "npx prisma db push --schema=backend/prisma/schema.prisma",
    "prisma:seed": "node backend/prisma/seed.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.109.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.27.0",
    "nodemailer": "^10.0.10",
    "postcss": "^8.5.21",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  }
}
