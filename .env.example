# ==========================================
# H&S MONOLITH - ENVIRONMENT VARIABLES & API KEYS
# ==========================================

# 1. SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
TZ=Asia/Kolkata
CLIENT_URL=http://localhost:5173,http://localhost:3000

# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/hs_monolith?schema=public"

# 3. AUTHENTICATION & SECURITY
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-32-chars-min"

# 4. CASHFREE PAYMENT GATEWAY
# Get keys from https://merchant.cashfree.com/
CASHFREE_APP_ID="TEST10000000000000000000000000000"
CASHFREE_SECRET_KEY="cfsk_ma_test_00000000000000000000000000000000"
CASHFREE_ENV="SANDBOX" # Options: SANDBOX or PRODUCTION
CASHFREE_WEBHOOK_SECRET="your-cashfree-webhook-secret"

# 5. SUPABASE STORAGE & DATABASE (Optional)
# Get keys from Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 6. SMTP EMAIL CONFIGURATION (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@hiandshi.shop"
SMTP_PASS="your-app-password"
SMTP_FROM="H&S Store <notifications@hiandshi.shop>"

# 7. FRONTEND VITE ENVIRONMENT VARIABLES (Exposed to Client)
VITE_API_BASE_URL="http://localhost:5000/api"
